<Project>
  <!-- Settings shared by every .NET project in the Windows app. -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <BaseOutputPath>$(MSBuildThisFileDirectory)artifacts\bin\$(MSBuildProjectName)\</BaseOutputPath>
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)artifacts\obj\$(MSBuildProjectName)\</BaseIntermediateOutputPath>
    <!-- Keep output paths free of the platform folder, however a project is built, so scripts and CI can rely on them. -->
    <AppendPlatformToOutputPath>false</AppendPlatformToOutputPath>
    <!-- The native engine is built per platform; AnyCPU projects use the x64 build. -->
    <EnginePlatform Condition="'$(Platform)' == 'ARM64'">ARM64</EnginePlatform>
    <EnginePlatform Condition="'$(EnginePlatform)' == ''">x64</EnginePlatform>
    <EngineDir>$(MSBuildThisFileDirectory)artifacts\engine\$(EnginePlatform)\$(Configuration)\</EngineDir>
  </PropertyGroup>
</Project>
