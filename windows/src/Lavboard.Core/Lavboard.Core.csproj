<Project Sdk="Microsoft.NET.Sdk">
  <!-- The app's model (tracks, mic systems, engine planning) and the managed side of the engine:
       P/Invoke bindings to LavboardEngine.dll and wrappers around them. Shared by the app and the
       tests, so everything here is testable without a window. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <Platforms>x64;ARM64</Platforms>
  </PropertyGroup>
  <ItemGroup>
    <!-- Build the native engine first and ship it next to whoever references this project. -->
    <ProjectReference Include="..\LavboardEngine\LavboardEngine.vcxproj" ReferenceOutputAssembly="false"
                      SetPlatform="Platform=$(EnginePlatform)" SkipGetTargetFrameworkProperties="true" />
    <None Include="$(EngineDir)LavboardEngine.dll" Link="LavboardEngine.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>
</Project>
