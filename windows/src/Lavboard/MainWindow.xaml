<Window
    x:Class="Lavboard.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Lavboard">
    <!-- Title bar, banners, desk and transport; built in MainWindow.xaml.cs from the views. -->
    <Grid x:Name="Root" Background="{StaticResource ConsoleBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- The macOS unified toolbar: title over subtitle on the left, capsule buttons on the right. -->
        <Grid x:Name="TitleBar" Height="52">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="CaptionInset" Width="0" />
            </Grid.ColumnDefinitions>
            <Grid x:Name="DragArea" Background="Transparent">
                <StackPanel VerticalAlignment="Center" Margin="16,0,0,0" Spacing="0">
                    <TextBlock x:Name="TitleText" FontFamily="{StaticResource InterBold}" FontWeight="Bold" FontSize="13"
                               Foreground="{StaticResource ConsoleSilk}" />
                    <TextBlock x:Name="SubtitleText" FontSize="11" Foreground="{StaticResource ConsoleEngraving}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
            <StackPanel x:Name="Toolbar" Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="0,0,12,0" VerticalAlignment="Center" />
        </Grid>

        <StackPanel x:Name="Banners" Grid.Row="1" />
    </Grid>
</Window>
