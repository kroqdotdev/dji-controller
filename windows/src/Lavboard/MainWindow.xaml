<Window
    x:Class="Lavboard.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Lavboard"
    Title="Lavboard">
    <Grid Background="{StaticResource ConsoleBackground}" Padding="28,20,28,28" RowSpacing="18">
        <Grid.Resources>
            <DataTemplate x:Key="DeviceRow" x:DataType="local:DeviceRow">
                <Grid Background="{StaticResource ConsoleWell}" CornerRadius="6" Padding="12,9" Margin="0,0,0,6">
                    <StackPanel Spacing="1">
                        <TextBlock Text="{x:Bind Name}" FontSize="14" Foreground="{StaticResource ConsoleSilk}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{x:Bind Detail}" FontSize="12" Foreground="{StaticResource ConsoleEngraving}" />
                    </StackPanel>
                </Grid>
            </DataTemplate>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="2">
            <TextBlock Text="Lavboard" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource ConsoleSilk}" />
            <TextBlock x:Name="Subtitle" FontSize="13" Foreground="{StaticResource ConsoleEngraving}" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Background="{StaticResource ConsolePanel}" CornerRadius="10" Padding="18">
                <StackPanel Spacing="10">
                    <TextBlock Text="Inputs" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource ConsoleSilk}" />
                    <ItemsControl x:Name="InputList" ItemTemplate="{StaticResource DeviceRow}" />
                    <TextBlock x:Name="NoInputs" Visibility="Collapsed" TextWrapping="WrapWholeWords" FontSize="13"
                               Foreground="{StaticResource ConsoleEngraving}" Text="No inputs. Plug in the DJI receiver, a USB mic or an audio interface." />
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Background="{StaticResource ConsolePanel}" CornerRadius="10" Padding="18">
                <StackPanel Spacing="10">
                    <TextBlock Text="Outputs" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource ConsoleSilk}" />
                    <ItemsControl x:Name="OutputList" ItemTemplate="{StaticResource DeviceRow}" />
                    <TextBlock x:Name="NoOutputs" Visibility="Collapsed" TextWrapping="WrapWholeWords" FontSize="13"
                               Foreground="{StaticResource ConsoleEngraving}" Text="No outputs. The stream and venue mixes need somewhere to go." />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
