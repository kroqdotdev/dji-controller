<Project Sdk="Microsoft.NET.Sdk">
  <!-- Lavboard for Windows: WinUI 3 on the Windows App SDK, unpackaged and self-contained, so it
       installs and updates like a normal desktop app. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>Lavboard</RootNamespace>
    <AssemblyName>Lavboard</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <!-- The self-contained Windows App SDK needs a concrete architecture. -->
    <RuntimeIdentifier Condition="'$(Platform)' == 'ARM64'">win-arm64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- Unpackaged too, but publishing needs the MSIX tooling to carry Lavboard.pri and the
         compiled XAML (.xbf) into the output; without it the installed app can't load its UI. -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <Version>0.1.0</Version>
    <ApplicationIcon>Assets\Lavboard.ico</ApplicationIcon>
    <!-- Program.cs is the entry point: Velopack's hooks run before the window. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Assets\Fonts\*.ttf" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Lavboard.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Fonts\*-OFL.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Lavboard.Core\Lavboard.Core.csproj" />
  </ItemGroup>
</Project>
