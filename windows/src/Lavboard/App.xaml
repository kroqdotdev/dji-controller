<Application
    x:Class="Lavboard.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!-- Controls.xaml merges Console.xaml, the design tokens. -->
                <ResourceDictionary Source="ms-appx:///Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>



            <!-- System controls (menus, text fields, check boxes) use Inter at the macOS size, 13. -->
            <FontFamily x:Key="ContentControlThemeFontFamily">ms-appx:///Assets/Fonts/Inter-Regular.ttf#Inter</FontFamily>
            <x:Double x:Key="ControlContentThemeFontSize">13</x:Double>

            <!-- The macOS accent: blue fills with white text, for Done and check boxes. -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <Color x:Key="SystemAccentColorLight1">#0A84FF</Color>
                    <Color x:Key="SystemAccentColorLight2">#0A84FF</Color>
                    <Color x:Key="SystemAccentColorLight3">#3D9BFF</Color>
                    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#0A84FF" />
                    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#2A93FF" />
                    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#0A6FD6" />
                    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="#E6FFFFFF" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
