<!--
  The console design tokens, transcribed from the macOS app's Theme.swift so both apps look the same.
  One accent (red) for the two "hot" states: muted and recording. Meter green and amber are data
  colours, not accents. Radius rule: containers 10, keys 6, tape 2.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="ConsoleBackgroundColor">#1F2428</Color>
    <Color x:Key="ConsolePanelColor">#2B3136</Color>
    <Color x:Key="ConsoleWellColor">#171B1E</Color>
    <Color x:Key="ConsoleEngravingColor">#9AA4AB</Color>
    <Color x:Key="ConsoleSilkColor">#E6E9EB</Color>
    <Color x:Key="ConsoleTapeColor">#ECEAE2</Color>
    <Color x:Key="ConsoleInkColor">#1D2024</Color>
    <Color x:Key="ConsoleRedColor">#E5484D</Color>
    <Color x:Key="ConsoleGreenColor">#4CC38A</Color>
    <Color x:Key="ConsoleAmberColor">#F2B33D</Color>

    <SolidColorBrush x:Key="ConsoleBackground" Color="{StaticResource ConsoleBackgroundColor}" />
    <SolidColorBrush x:Key="ConsolePanel" Color="{StaticResource ConsolePanelColor}" />
    <SolidColorBrush x:Key="ConsoleWell" Color="{StaticResource ConsoleWellColor}" />
    <SolidColorBrush x:Key="ConsoleEngraving" Color="{StaticResource ConsoleEngravingColor}" />
    <SolidColorBrush x:Key="ConsoleSilk" Color="{StaticResource ConsoleSilkColor}" />
    <SolidColorBrush x:Key="ConsoleTape" Color="{StaticResource ConsoleTapeColor}" />
    <SolidColorBrush x:Key="ConsoleInk" Color="{StaticResource ConsoleInkColor}" />
    <SolidColorBrush x:Key="ConsoleRed" Color="{StaticResource ConsoleRedColor}" />
    <SolidColorBrush x:Key="ConsoleAmber" Color="{StaticResource ConsoleAmberColor}" />
    <SolidColorBrush x:Key="ConsoleGreen" Color="{StaticResource ConsoleGreenColor}" />
    <!-- The off key's hairline: silk at 14%. -->
    <SolidColorBrush x:Key="ConsoleKeyStroke" Color="{StaticResource ConsoleSilkColor}" Opacity="0.14" />
    <SolidColorBrush x:Key="ConsoleSlotStroke" Color="{StaticResource ConsoleEngravingColor}" Opacity="0.45" />

    <!-- macOS dark-mode system colours for popovers and pop-up buttons. -->
    <SolidColorBrush x:Key="PopoverBackground" Color="#2A2D31" />
    <SolidColorBrush x:Key="PopoverStroke" Color="#FFFFFF" Opacity="0.12" />
    <SolidColorBrush x:Key="PopUpFill" Color="#FFFFFF" Opacity="0.1" />
    <SolidColorBrush x:Key="SwitchOff" Color="#FFFFFF" Opacity="0.16" />
    <SolidColorBrush x:Key="SegmentSelected" Color="#FFFFFF" Opacity="0.22" />
    <SolidColorBrush x:Key="FormSeparator" Color="#FFFFFF" Opacity="0.08" />
    <SolidColorBrush x:Key="SecondaryLabel" Color="#FFFFFF" Opacity="0.55" />
    <SolidColorBrush x:Key="TertiaryLabel" Color="#FFFFFF" Opacity="0.25" />

    <CornerRadius x:Key="ContainerRadius">10</CornerRadius>
    <CornerRadius x:Key="KeyRadius">6</CornerRadius>
    <CornerRadius x:Key="TapeRadius">2</CornerRadius>

    <!--
      SF Pro is the macOS face and can't ship on Windows. Inter is the closest open-licensed match
      for UI text; Barlow Condensed stands in for SF Pro's compressed and condensed widths (tape
      labels and strip labels). Both are bundled under the SIL Open Font License.
    -->
    <FontFamily x:Key="InterRegular">ms-appx:///Assets/Fonts/Inter-Regular.ttf#Inter</FontFamily>
    <FontFamily x:Key="InterMedium">ms-appx:///Assets/Fonts/Inter-Medium.ttf#Inter</FontFamily>
    <FontFamily x:Key="InterSemiBold">ms-appx:///Assets/Fonts/Inter-SemiBold.ttf#Inter</FontFamily>
    <FontFamily x:Key="InterBold">ms-appx:///Assets/Fonts/Inter-Bold.ttf#Inter</FontFamily>
    <FontFamily x:Key="TapeFont">ms-appx:///Assets/Fonts/BarlowCondensed-ExtraBold.ttf#Barlow Condensed</FontFamily>
    <FontFamily x:Key="CondensedFont">ms-appx:///Assets/Fonts/BarlowCondensed-SemiBold.ttf#Barlow Condensed</FontFamily>

    <!-- Font.stripLabel: 12 pt semibold condensed. -->
    <Style x:Key="StripLabelText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource CondensedFont}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource ConsoleEngraving}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- Font.value: 15 pt semibold, tabular digits. -->
    <Style x:Key="ValueText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource InterSemiBold}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Foreground" Value="{StaticResource ConsoleSilk}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <!-- Font.scale: 9 pt medium, tabular digits. -->
    <Style x:Key="ScaleText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource InterMedium}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="FontSize" Value="9" />
        <Setter Property="Foreground" Value="{StaticResource ConsoleEngraving}" />
    </Style>
    <!-- Captions like "Set gain on the device": 11 pt regular. -->
    <Style x:Key="CaptionText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource InterRegular}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource ConsoleEngraving}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
</ResourceDictionary>
