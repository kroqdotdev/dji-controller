<!-- Control templates for the console, matching the macOS app's button styles. -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Lavboard.Controls">

    <!-- A dictionary loaded from its own file only sees what it merges, so it brings the tokens along. -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="ms-appx:///Themes/Console.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- SwiftUI's .plain button: no chrome, slightly dimmed while pressed. -->
    <Style x:Key="PlainButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <ContentPresenter x:Name="Presenter" Background="{TemplateBinding Background}"
                                      Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                      Padding="{TemplateBinding Padding}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver" />
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Presenter.Opacity" Value="0.8" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Presenter.Opacity" Value="0.4" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </ContentPresenter>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- KeyStyle: a console key, flat when off, backlit when on, with an optional corner legend. -->
    <Style x:Key="KeyButtonStyle" TargetType="controls:KeyButton">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontFamily" Value="{StaticResource InterSemiBold}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource KeyRadius}" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:KeyButton">
                    <Grid x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                          BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}"
                          Padding="{TemplateBinding Padding}" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="Press" />
                        </Grid.RenderTransform>
                        <ContentPresenter Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                                          FontFamily="{TemplateBinding FontFamily}" FontWeight="{TemplateBinding FontWeight}"
                                          FontSize="{TemplateBinding FontSize}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        <TextBlock Text="{TemplateBinding Legend}" Foreground="{TemplateBinding Foreground}" Opacity="0.6"
                                   FontFamily="{StaticResource InterBold}" FontWeight="Bold" FontSize="10"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,9,0" />
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver" />
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Press.ScaleX" Value="0.98" />
                                        <Setter Target="Press.ScaleY" Value="0.98" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Opacity" Value="0.4" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The macOS 26 toolbar's 36 pt glass capsules ("4-track", "Settings"), without an outline. -->
    <Style x:Key="ToolbarButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource ConsolePanel}" />
        <Setter Property="Foreground" Value="{StaticResource ConsoleSilk}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="8,0,8,1" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- A link-style button (SwiftUI .link): plain text that acts like a button. -->
    <Style x:Key="LinkButton" TargetType="HyperlinkButton">
        <Setter Property="Foreground" Value="{StaticResource ConsoleSilk}" />
        <Setter Property="FontFamily" Value="{StaticResource InterRegular}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- PickerRowStyle: a full-width row in the source picker, highlighted on hover. -->
    <Style x:Key="PickerRowButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource ConsoleSilk}" />
        <Setter Property="Padding" Value="8,5,8,5" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="CornerRadius" Value="{StaticResource KeyRadius}" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root" Background="Transparent" CornerRadius="{TemplateBinding CornerRadius}">
                        <Rectangle x:Name="Highlight" Fill="{StaticResource ConsoleSilkColor}" Opacity="0" />
                        <ContentPresenter x:Name="Presenter" Content="{TemplateBinding Content}" Padding="{TemplateBinding Padding}"
                                          Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}"
                                          HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center" />
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Highlight.Opacity" Value="0.09" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Highlight.Opacity" Value="0.16" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Presenter.Opacity" Value="0.4" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The macOS popover: a dark sheet with a hairline edge. -->
    <Style x:Key="PopoverPresenter" TargetType="FlyoutPresenter">
        <Setter Property="Background" Value="{StaticResource PopoverBackground}" />
        <Setter Property="BorderBrush" Value="{StaticResource PopoverStroke}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource ContainerRadius}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MaxWidth" Value="480" />
        <Setter Property="MaxHeight" Value="640" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    </Style>


    <!-- A section heading in a popover (SwiftUI .subheadline in secondary colour). -->
    <Style x:Key="PopoverHeading" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource SecondaryLabel}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <!-- SwiftUI .headline: 13 pt bold. -->
    <Style x:Key="PopoverTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource InterBold}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource ConsoleSilk}" />
    </Style>
    <!-- SwiftUI .caption: 10 pt, secondary or tertiary. -->
    <Style x:Key="PopoverNote" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Foreground" Value="{StaticResource SecondaryLabel}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- The macOS pop-up button's chrome; PopUpButton supplies the text and chevrons. -->
    <Style x:Key="PopUpButtonStyle" TargetType="controls:PopUpButton">
        <Setter Property="Background" Value="{StaticResource PopUpFill}" />
        <Setter Property="Foreground" Value="{StaticResource ConsoleSilk}" />
        <Setter Property="Padding" Value="12,3,9,4" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="CornerRadius" Value="{StaticResource KeyRadius}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:PopUpButton">
                    <Grid x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}">
                        <Rectangle x:Name="Highlight" Fill="{StaticResource ConsoleSilkColor}" Opacity="0" />
                        <ContentPresenter x:Name="Presenter" Content="{TemplateBinding Content}" Padding="{TemplateBinding Padding}"
                                          Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}"
                                          HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center" />
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver" />
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Highlight.Opacity" Value="0.08" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Presenter.Opacity" Value="0.4" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The macOS check box: a 15 pt rounded square, blue with a white tick when on. -->
    <Style x:Key="MacCheckBox" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource ConsoleSilk}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="6,0,0,0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid x:Name="Root" Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="Box" Width="15" Height="15" CornerRadius="4" VerticalAlignment="Center"
                                Background="{StaticResource PopUpFill}" BorderBrush="{StaticResource PopoverStroke}" BorderThickness="1">
                            <FontIcon x:Name="Tick" Glyph="&#xE73E;" FontSize="9" FontWeight="Bold" Foreground="White" Opacity="0" />
                        </Border>
                        <ContentPresenter x:Name="Presenter" Grid.Column="1" Content="{TemplateBinding Content}" Padding="{TemplateBinding Padding}"
                                          Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}" VerticalAlignment="Center" />
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CombinedStates">
                                <VisualState x:Name="UncheckedNormal" />
                                <VisualState x:Name="UncheckedPointerOver" />
                                <VisualState x:Name="UncheckedPressed" />
                                <VisualState x:Name="UncheckedDisabled">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Opacity" Value="0.4" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="CheckedNormal">
                                    <VisualState.Setters>
                                        <Setter Target="Box.Background" Value="#0A84FF" />
                                        <Setter Target="Box.BorderBrush" Value="#0A84FF" />
                                        <Setter Target="Tick.Opacity" Value="1" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="CheckedPointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Box.Background" Value="#0A84FF" />
                                        <Setter Target="Box.BorderBrush" Value="#0A84FF" />
                                        <Setter Target="Tick.Opacity" Value="1" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="CheckedPressed">
                                    <VisualState.Setters>
                                        <Setter Target="Box.Background" Value="#0A6FD6" />
                                        <Setter Target="Box.BorderBrush" Value="#0A6FD6" />
                                        <Setter Target="Tick.Opacity" Value="1" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="CheckedDisabled">
                                    <VisualState.Setters>
                                        <Setter Target="Box.Background" Value="#0A84FF" />
                                        <Setter Target="Tick.Opacity" Value="1" />
                                        <Setter Target="Root.Opacity" Value="0.4" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="IndeterminateNormal" />
                                <VisualState x:Name="IndeterminatePointerOver" />
                                <VisualState x:Name="IndeterminatePressed" />
                                <VisualState x:Name="IndeterminateDisabled" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The macOS switch: a blue capsule with a white knob when on. -->
    <Style x:Key="MacSwitch" TargetType="ToggleButton">
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid x:Name="Root" Width="32" Height="18" CornerRadius="9" Background="{StaticResource SwitchOff}">
                        <Ellipse x:Name="Knob" Width="14" Height="14" Fill="White" HorizontalAlignment="Left" Margin="2,0,2,0" />
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver" />
                                <VisualState x:Name="Pressed" />
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Opacity" Value="0.4" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Checked">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="#0A84FF" />
                                        <Setter Target="Knob.HorizontalAlignment" Value="Right" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="CheckedPointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="#0A84FF" />
                                        <Setter Target="Knob.HorizontalAlignment" Value="Right" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="CheckedPressed">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="#0A6FD6" />
                                        <Setter Target="Knob.HorizontalAlignment" Value="Right" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="CheckedDisabled">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="#0A84FF" />
                                        <Setter Target="Knob.HorizontalAlignment" Value="Right" />
                                        <Setter Target="Root.Opacity" Value="0.4" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
