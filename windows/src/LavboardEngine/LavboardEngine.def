    AudioCoreIOProc
    AudioCoreAsyncCreate
    AudioCoreAsyncDestroy
    AudioCoreAsyncLookahead
    AudioCoreAsyncIOProc
    AudioCoreAsyncRender
    AudioCoreAsyncOutput
    AudioCoreAsyncReadStats
    ; Windows device layer
    LbEngineVersion
    LbListDevices
