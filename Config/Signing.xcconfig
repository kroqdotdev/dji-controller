// Code signing. Defaults to ad-hoc signing so anyone can build.
// To sign with your own Apple Development identity (recommended: macOS then keeps the
// microphone permission across rebuilds), create Config/Local.xcconfig, which is git-ignored:
//
//   DEVELOPMENT_TEAM = YOURTEAMID
//   CODE_SIGN_IDENTITY = Apple Development

CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = -
DEVELOPMENT_TEAM =

#include? "Local.xcconfig"
